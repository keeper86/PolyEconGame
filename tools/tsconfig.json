{
    "compilerOptions": {
        "target": "es2017",
        "lib": ["es6", "dom"],
        "module": "commonjs",
        "moduleResolution": "node",
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "noEmit": true,
        "baseUrl": "..",
        "paths": { "@/*": ["./src/*"] }
    },
    "include": ["longrun/*.ts"]
}
